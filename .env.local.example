# Firebase configuration — copy to .env.local and fill in.
# Get values from console.firebase.google.com:
#   Project Settings → Your apps → Web app → "Firebase SDK snippet" → Config
#
# These are PUBLIC keys (NEXT_PUBLIC_) — safe to ship in client bundles.
# Security is enforced by:
#   1. Firestore security rules (server-side)
#   2. The single-admin email gate in src/lib/firebase/auth.ts
#
# NEVER add the Firebase Admin SDK service account JSON to this file or
# any committed file. The admin SDK must only be used by build-time scripts.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
